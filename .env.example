# Telegram Bot (Get token from @BotFather)
TELEGRAM_TOKEN=YOUR_NEW_BOT_TOKEN_FROM_BOTFATHER
WEBHOOK_URL=https://jurtin.de/tour-bot/webhook

# Ollama (local LLM) — CT 114
OLLAMA_HOST=http://192.168.178.140:11434

# Paths
UPLOADS_DIR=/mnt/nas/tour-inputs
NAS_OUTBOX=/mnt/nas/tour-inputs/outbox
DB_PATH=/data/tour-bot.db
ASTRO_REPO=/opt/astro

# Access control — comma-separated Telegram numeric user_ids. Empty/unset = open to
# anyone (logs each sender's user_id at INFO so you can find IDs to add).
ALLOWED_USER_IDS=

# Staging deploy (rsync target for /publish; production is a separate /golive step)
STAGING_HOST=192.168.178.216
STAGING_SSH_KEY=/root/.ssh/staging_deploy
STAGING_REMOTE_DIR=/var/www/staging
